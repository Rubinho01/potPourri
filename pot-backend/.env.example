NODE_ENV=development
PORT=3333

# Banco de dados
DB_HOST=localhost
DB_PORT=5433
DB_NAME=pot
DB_USER=pot
DB_PASSWORD=pot
DB_DIALECT=postgres

# JWT
JWT_SECRET=troque-por-uma-string-aleatoria-longa
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=troque-por-outra-string-aleatoria-diferente
JWT_REFRESH_EXPIRES_IN=7d
# mesmo valor do de cima, em dias (usado pra calcular a data de expiração salva no banco)
JWT_REFRESH_EXPIRES_IN_DAYS=7