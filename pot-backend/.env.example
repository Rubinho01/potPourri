NODE_ENV=development
PORT=3333

# Banco de dados
DB_HOST=localhost
DB_PORT=5433
DB_NAME=pot
DB_USER=pot
DB_PASSWORD=pot
DB_DIALECT=postgres

# JWT
JWT_SECRET=troque-por-uma-string-aleatoria-longa
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=troque-por-outra-string-aleatoria-diferente
JWT_REFRESH_EXPIRES_IN=7d
# mesmo valor do de cima, em dias (usado pra calcular a data de expiração salva no banco)
JWT_REFRESH_EXPIRES_IN_DAYS=7

# Cloudinary (pegue em https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=seu-cloud-name
CLOUDINARY_API_KEY=sua-api-key
CLOUDINARY_API_SECRET=sua-api-secret 

# Primeiro administrador (só admin cadastra novos usuários).
# Na inicialização, cria esse usuário como admin — ou promove, se o e-mail já existir.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@potpourri.com
ADMIN_PASSWORD=troque-esta-senha
